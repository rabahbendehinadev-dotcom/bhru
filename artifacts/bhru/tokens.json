{
  "$description": "BHRU design tokens (DTCG). Mirrored as CSS variables in src/index.css.",
  "color": {
    "$type": "color",
    "bg": { "base": { "$value": "hsl(222 42% 7%)" }, "card": { "$value": "hsl(222 36% 10%)" }, "sidebar": { "$value": "hsl(223 44% 6%)" }, "muted": { "$value": "hsl(222 30% 13%)" } },
    "border": { "default": { "$value": "hsl(222 24% 18%)" }, "input": { "$value": "hsl(222 24% 22%)" } },
    "text": { "default": { "$value": "hsl(214 30% 92%)" }, "muted": { "$value": "hsl(218 15% 62%)" } },
    "accent": { "primary": { "$value": "hsl(217 91% 56%)" }, "brand": { "$value": "hsl(24 96% 53%)", "$description": "Logo and registration CTA" }, "violet": { "$value": "hsl(262 70% 62%)" } },
    "status": { "ok": { "$value": "hsl(152 60% 42%)" }, "warn": { "$value": "hsl(30 95% 55%)" }, "danger": { "$value": "hsl(0 72% 56%)" } }
  },
  "dimension": { "radius": { "sm": { "$value": "6px", "$type": "dimension" }, "md": { "$value": "10px", "$type": "dimension" } }, "control-height": { "$value": "32px", "$type": "dimension" }, "row-padding": { "$value": "7px", "$type": "dimension" } },
  "fontFamily": { "sans": { "$value": ["Geist", "system-ui", "sans-serif"], "$type": "fontFamily" }, "mono": { "$value": ["Geist Mono", "monospace"], "$type": "fontFamily" } },
  "fontSize": { "base": { "$value": "13px", "$type": "dimension" }, "table": { "$value": "12px", "$type": "dimension" } }
}
